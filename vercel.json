{
  "version": 2,
  "name": "tally-mobile-pos",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/tally.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
